{
  "name": "persiantoolbox-image-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node worker.mjs",
    "health": "node health.mjs",
