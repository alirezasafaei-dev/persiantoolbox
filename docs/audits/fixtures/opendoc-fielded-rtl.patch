 }
+
+#[test]
+fn mixed_page_field_stays_inside_the_line_measure() {
+    let document = document(vec![paragraph(
+        100,
+        ParagraphProperties::default(),
+        vec![
+            run(101, "صفحه PT FOOTER MARKER "),
+            field(200, " PAGE ", "1"),
+        ],
+    )]);
+
+    let lines = lines(&document);
+    let line = lines.first().expect("the paragraph lays out one line");
+    assert_eq!(line.fields.len(), 1);
+    let field = &line.runs[line.fields[0].run as usize];
+    assert!(!field.glyphs.is_empty(), "the page value has glyphs");
+    assert!(
+        line.runs.iter().all(|run| run.origin.x >= Twip::ZERO && run.origin.x < MEASURE),
+        "short text and its PAGE field must stay within the available measure; got {:?}",
+        line.runs.iter().map(|run| run.origin.x).collect::<Vec<_>>()
+    );
+}
