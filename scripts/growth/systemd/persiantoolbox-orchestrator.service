[Unit]
Description=PersianToolbox Growth Orchestrator
After=network.target

[Service]
Type=simple
User=asdev
WorkingDirectory=/home/asdev/persiantoolbox
ExecStart=/usr/bin/npx tsx scripts/growth/agent-loop/index.ts poll
Restart=always
RestartSec=10
Environment=NODE_ENV=production
EnvironmentFile=/home/asdev/persiantoolbox/.env

[Install]
WantedBy=multi-user.target
