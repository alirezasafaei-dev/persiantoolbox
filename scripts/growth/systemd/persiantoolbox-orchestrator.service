[Unit]
Description=PersianToolbox Agent Control Plane
After=network.target

[Service]
Type=simple
User=asdev
WorkingDirectory=/home/asdev/persiantoolbox-agent
ExecStart=/home/asdev/persiantoolbox-agent/node_modules/.bin/tsx scripts/growth/agent-loop/index.ts poll --interval 180000
Restart=always
RestartSec=30
Environment=NODE_ENV=production
Environment=PATH=/home/asdev/.opencode/bin:/usr/local/bin:/usr/bin:/bin
# REVIEW_SECRET isolation (v3.1):
# - REVIEW_SECRET may be present in this orchestrator process env (loaded from
#   .env) ONLY for signature VERIFICATION of review artifacts.
# - executor.ts (buildExecutorEnv) explicitly STRIPS REVIEW_SECRET from the
#   opencode subprocess environment, so the agent executor NEVER receives it.
# - The review-ingestion service (review-ingest.ts) is the only process that
#   CREATES signed artifacts; run it separately with REVIEW_SECRET exported.
# - Never log or commit REVIEW_SECRET.
EnvironmentFile=/home/asdev/persiantoolbox-agent/.env

[Install]
WantedBy=multi-user.target